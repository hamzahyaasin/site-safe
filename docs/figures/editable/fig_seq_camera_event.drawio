        <mxCell id="c56" value="Dashed arrows are replies. The dashboard receives the event when the alert is committed, before the camera gets its reply." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=7.5;fontColor=#4b5563;fontStyle=2;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
