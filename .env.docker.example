# Copy to .env.docker (git-ignored) and change the secrets.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
DB_NAME=sitesafe
DB_USER=sitesafe
DB_PASSWORD=change-me
JWT_ACCESS_MINUTES=30
VEST_OFFLINE_AFTER_SECONDS=120
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Mount a Firebase service-account file and point this at it to enable push
FIREBASE_CREDENTIALS_PATH=
SITE_NAME=Site-Safe
TIME_ZONE=Asia/Karachi
# Alert evidence (FR-29): store camera snapshots, and delete them after N days
ALERT_SNAPSHOTS_ENABLED=True
ALERT_SNAPSHOT_RETENTION_DAYS=30
